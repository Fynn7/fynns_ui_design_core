{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-agent-slim-advice-lite.md",
    "style": "markdown",
    "compress": true,
    "removeEmptyLines": true,
    "removeComments": true,
    "topFilesLength": 30,
    "includeFullDirectoryStructure": true,
    "instructionFilePath": "repomix.agent-slim-advice.instruction.md",
    "headerText": "LITE pack for browser LLMs. Includes DESIGN_SYSTEM stub + slim BREAKING_PURGE. OMITTED: docs/design-system chapters, BREAKING_PURGE archive, consumer-cursor-rule, CHAT_*, machine JSON twins, examples/sandbox, primitives+css, tokens.ts."
  },
  "include": [
    "AGENTS.md",
    "README.md",
    "CLAUDE.md",
    "package.json",
    "docs/DESIGN_SYSTEM.md",
    "docs/package-propagation.md",
    "llm/LOCAL_LLM.md",
    "llm/CONSUME.md",
    "llm/CONSUMER_TREATY.md",
    "llm/PERF.md",
    "llm/AGENT_INTERFACES.md",
    "llm/BREAKING_PURGE.md",
    "openwiki/**/*.md",
    ".cursor/rules/**/*.mdc",
    ".cursor/skills/**/*.md",
    ".cursor/commands/**/*.md",
    "src/index.ts",
    "repomix.*.config.json"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "examples/**",
      ".tmp*",
      "repomix-*.md",
      "**/*.png",
      "node_modules/**",
      "dist/**",
      "e2e/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.css",
      "src/theme/**",
      "src/primitives/**",
      "src/layout/**",
      "src/scheduling/**",
      "package-lock.json",
      "docs/design-system/**",
      "docs/archive/**",
      "llm/archive/**",
      "llm/consumer-cursor-rule.mdc",
      "llm/CHAT_*.md",
      "llm/m3-draft-tokens.md",
      "llm/opencode-fynns-ui-consume.md",
      "llm/agent-interfaces.json",
      "llm/consume.json",
      "llm/wysiwyg-companion.json"
    ]
  }
}
