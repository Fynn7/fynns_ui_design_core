{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-agent-slim-advice-lite.md",
    "style": "markdown",
    "compress": true,
    "removeEmptyLines": true,
    "removeComments": true,
    "topFilesLength": 30,
    "includeFullDirectoryStructure": true,
    "instructionFilePath": "repomix.agent-slim-advice.instruction.md",
    "headerText": "LITE pack for browser LLMs (~target under 40k tokens). OMITTED on purpose (too large for paste): docs/DESIGN_SYSTEM.md (~32k tok), llm/BREAKING_PURGE.md (~19k), llm/consumer-cursor-rule.mdc (~11k), llm/CHAT_*.md, examples/sandbox (Globals~328KB, i18n~382KB), src/primitives+css, tokens.ts. Full directory tree is included. See companion hotspot section if present."
  },
  "include": [
    "AGENTS.md",
    "README.md",
    "CLAUDE.md",
    "package.json",
    "docs/package-propagation.md",
    "docs/submodule-propagation.md",
    "llm/LOCAL_LLM.md",
    "llm/CONSUME.md",
    "llm/CONSUMER_TREATY.md",
    "llm/PERF.md",
    "llm/AGENT_INTERFACES.md",
    "llm/consume.json",
    "llm/agent-interfaces.json",
    "llm/wysiwyg-companion.json",
    "openwiki/**/*.md",
    ".cursor/rules/**/*.mdc",
    ".cursor/skills/**/*.md",
    ".cursor/commands/**/*.md",
    "src/index.ts",
    "repomix.*.config.json"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "node_modules/**",
      "dist/**",
      "examples/**",
      "e2e/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.css",
      "src/theme/**",
      "src/primitives/**",
      "src/layout/**",
      "src/scheduling/**",
      "package-lock.json",
      "docs/DESIGN_SYSTEM.md",
      "llm/BREAKING_PURGE.md",
      "llm/consumer-cursor-rule.mdc",
      "llm/CHAT_*.md",
      "llm/m3-draft-tokens.md",
      "llm/opencode-fynns-ui-consume.md",
      ".tmp*/**",
      ".tmp*",
      "**/*.png",
      "repomix-*.md"
    ]
  }
}
