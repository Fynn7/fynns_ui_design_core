{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-agent-slim-advice.md",
    "style": "markdown",
    "compress": true,
    "removeEmptyLines": true,
    "removeComments": true,
    "topFilesLength": 25,
    "includeFullDirectoryStructure": true,
    "instructionFilePath": "repomix.agent-slim-advice.instruction.md",
    "headerText": "Agent-token slim-down advice pack for fynns_ui_design_core. Structure + agent surface docs; code compressed; bulky CSS/sandbox/tests/machine JSON twins omitted on purpose. DESIGN_SYSTEM is the stub index only — chapters under docs/design-system/."
  },
  "include": [
    "AGENTS.md",
    "README.md",
    "CLAUDE.md",
    "package.json",
    "docs/DESIGN_SYSTEM.md",
    "docs/design-system/**/*.md",
    "docs/package-propagation.md",
    "docs/archive/**/*.md",
    "llm/**/*.md",
    "llm/**/*.mdc",
    "openwiki/**/*.md",
    ".cursor/rules/**/*.mdc",
    ".cursor/skills/**/*.md",
    ".cursor/commands/**/*.md",
    "src/index.ts",
    "repomix.*.config.json",
    "llm/LOCAL_LLM.md"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "examples/**",
      ".tmp*",
      "repomix-*.md",
      "**/*.png",
      "node_modules/**",
      "dist/**",
      "e2e/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.css",
      "src/theme/tokens.ts",
      "src/primitives/**",
      "src/layout/**",
      "src/scheduling/**",
      "package-lock.json",
      "llm/archive/**",
      "llm/CHAT_*.md",
      "llm/agent-interfaces.json",
      "llm/consume.json",
      "llm/wysiwyg-companion.json",
      "**/*.jpg",
      "**/*.webp"
    ]
  }
}
